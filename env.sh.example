# Copy to env.sh (gitignored) and fill in. Every extra_eval/*.sh sources it from the repo root.
# Keep this project's own copy of every dependency under deps/ (gitignored; hard links or copies,
# a symlink only into a directory this project owns) and point the variables there.
# The ${VAR:-...} form lets a value given on the command line override this file.
# Unset variables fall back to the defaults listed in each script's header.

# --- environment (build_env.sh) ---
export LL3DA_ENV="${LL3DA_ENV:-/path/to/ll3da-venv}"
export LL3DA_CUDA_HOME="${LL3DA_CUDA_HOME:-/usr/local/cuda}"   # CUDA >= 12.8 toolkit, builds pointnet2 (env builds only)
export UV_CACHE_DIR="${UV_CACHE_DIR:-/path/to/cache/uv}"
export HF_HOME="${HF_HOME:-/path/to/cache/huggingface}"
# export TMPDIR=/path/to/tmp

# --- downloads (download.sh) and inference (run_infer.sh) ---
export LL3DA_HF="${LL3DA_HF:-/path/to/LL3DA-weight-release}"     # HF CH3COOK/LL3DA-weight-release: ll3da-opt-1.3b.pth, scannet_data.zip (unzipped)
export OPT_PATH="${OPT_PATH:-/path/to/opt-1.3b}"                   # HF facebook/opt-1.3b
export BERT_EMB="${BERT_EMB:-/path/to/bert-base-embedding}"        # HF CH3COOK/bert-base-embedding
export SCANREFER_DIR="${SCANREFER_DIR:-/path/to/ScanRefer}"        # ScanRefer_filtered_val.{json,txt}
export SCANQA_DIR="${SCANQA_DIR:-/path/to/ScanQA}"                 # ScanQA_v1.0_val.json
export SQA3D_TEST="${SQA3D_TEST:-/path/to/chat-scene/annotations/sqa3d_test.json}"   # HF dataset ZzZZCHS/Chat-Scene annotations/
export REAL3DQA_DIR="${REAL3DQA_DIR:-/path/to/Real-3DQA}"         # <split>.jsonl from HF Oliver-Ma/Real-3DQA
# Beacon3D 3RScan / MultiScan point clouds (prepare_scans.py, run by run_infer.sh if missing)
export RSCAN_RAW_DIR="${RSCAN_RAW_DIR:-/path/to/3RScan/scans}"          # <scan>/labels.instances.annotated.v2.ply
export MULTISCAN_RAW_DIR="${MULTISCAN_RAW_DIR:-/path/to/MultiScan/scans}" # HF 3dlg-hcvc/MultiScan scans/<scene>.zip
export BEACON3D_SCANS="${BEACON3D_SCANS:-/path/to/beacon3d_scans}"
# export PREFIX_CACHE=1                                            # fast path, see extra_eval/README.md

# --- scoring (score.sh) ---
# Java (8+) for METEOR, if not on PATH:
# export JAVA_HOME=/path/to/jre; export PATH="$JAVA_HOME/bin:$PATH"
export OPENAI_API_KEY="${OPENAI_API_KEY:-sk-...}"

# --- XR-QA / XR-SceneCaption (LSceneLLM), extra_eval/xr/ ---
export XR_DIR="${XR_DIR:-/path/to/XR}"                            # XR-QA/, XR-SceneCaption/ (HF Hoyard/XR-Scene)
export XR_SCAN_DATA="${XR_SCAN_DATA:-/path/to/XR/HM3D/scan_data}" # SceneVerse HM3D scan_data + room_center/ (HF Hoyard/HM3D_SceneVerse_RoomCenter)
export XR_CACHE="${XR_CACHE:-/path/to/xr_cache}"                  # prepare_xr.py output (~10 GB per-region points + normals)
export HM3D_GLB="${HM3D_GLB:-/path/to/hm3d-v0.2/glb}"            # <scan>/<hash>.glb: mesh normals for prepare_xr.py (NORMALS=glb)
export NORMALS_ENV="${NORMALS_ENV:-/path/to/venv-with-open3d}"    # open3d + trimesh + torch + scipy (prepare_xr.py --normals glb)
